import meta::pure::test::pct::*;
import meta::pure::metamodel::relation::*;
import meta::pure::tds::*;
import meta::pure::functions::relation::*;

Class meta::pure::functions::relation::_WindowDefinition<T> extends meta::pure::functions::relation::_Window<T>
{
  name: String[1];
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], cols:String[*], sortInfo:meta::pure::functions::relation::SortInfo<(?:?)⊆T>[*], frame:meta::pure::functions::relation::Frame[0..1]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  ^meta::pure::functions::relation::_WindowDefinition<T>
  (
    name=$name,
    partition=$cols,
    sortInfo=$sortInfo,
    frame = $frame
  );
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], cols:meta::pure::metamodel::relation::ColSpec<(?:?)⊆T>[1]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  ^_WindowDefinition<T>
  (
    name=$name,
    partition=$cols.name
  );
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], cols:meta::pure::metamodel::relation::ColSpecArray<(?:?)⊆T>[1]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  ^_WindowDefinition<T>
  (
    name=$name,
    partition=$cols.names
  );
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], sortInfo:meta::pure::functions::relation::SortInfo<(?:?)⊆T>[*]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  window($name, [], $sortInfo, [])
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], frame:meta::pure::functions::relation::Frame[1]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  window($name, [], [], $frame)
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], cols:meta::pure::metamodel::relation::ColSpec<(?:?)⊆T>[1], sortInfo:meta::pure::functions::relation::SortInfo<(?:?)⊆T>[*]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  window($name, $cols.name, $sortInfo, [])
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], cols:meta::pure::metamodel::relation::ColSpecArray<(?:?)⊆T>[1], sortInfo:meta::pure::functions::relation::SortInfo<(?:?)⊆T>[*]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  window($name, $cols.names, $sortInfo, [])
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], cols:meta::pure::metamodel::relation::ColSpec<(?:?)⊆T>[1], frame:meta::pure::functions::relation::Frame[1]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  window($name, $cols.name, [], $frame)
}

function
    <<functionType.NormalizeRequiredFunction,
    PCT.function>>
    meta::pure::functions::relation::window<T>(name:String[1], sortInfo:meta::pure::functions::relation::SortInfo<(?:?)⊆T>[*], frame:meta::pure::functions::relation::Frame[1]):meta::pure::functions::relation::_WindowDefinition<T>[1]
{
  window($name, [], $sortInfo, $frame)
}
