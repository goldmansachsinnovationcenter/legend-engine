import meta::relational::functions::sqlQueryToString::*;
import meta::relational::functions::sqlQueryToString::default::*;
import meta::relational::functions::sqlQueryToString::testSuite::selectSubClauses::*;
import meta::relational::metamodel::operation::*;
import meta::relational::metamodel::relation::*;
import meta::relational::metamodel::*;
import meta::relational::runtime::*;
import meta::pure::functions::relation::*;
import meta::pure::metamodel::relation::*;
import meta::pure::functions::collection::*;
import meta::pure::test::*;
import meta::pure::tds::*;

function <<test.Test>> meta::relational::tests::selectSubClauses::window::testSingleNamedWindow():Boolean[1]
{
   let expected = 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg", sum("root".val) OVER myWindow as "sum" from TDSRow as "root" WINDOW myWindow AS (PARTITION BY "root".col1 ORDER BY "root".col3 ASC)';
   
   assertEquals($expected, 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg", sum("root".val) OVER myWindow as "sum" from TDSRow as "root" WINDOW myWindow AS (PARTITION BY "root".col1 ORDER BY "root".col3 ASC)');
}

function <<test.Test>> meta::relational::tests::selectSubClauses::window::testMultipleNamedWindows():Boolean[1]
{
   let expected = 'select "root".id as "id", "root".val as "val", avg("root".val) OVER window1 as "avg1", avg("root".val) OVER window2 as "avg2" from TDSRow as "root" WINDOW window1 AS (PARTITION BY "root".col1 ORDER BY "root".col3 ASC), window2 AS (PARTITION BY "root".col2 ORDER BY "root".col4 DESC)';
   
   assertEquals($expected, 'select "root".id as "id", "root".val as "val", avg("root".val) OVER window1 as "avg1", avg("root".val) OVER window2 as "avg2" from TDSRow as "root" WINDOW window1 AS (PARTITION BY "root".col1 ORDER BY "root".col3 ASC), window2 AS (PARTITION BY "root".col2 ORDER BY "root".col4 DESC)');
}

function <<test.Test>> meta::relational::tests::selectSubClauses::window::testWindowWithFrame():Boolean[1]
{
   let expected = 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg" from TDSRow as "root" WINDOW myWindow AS (PARTITION BY "root".col1 ORDER BY "root".col3 ASC ROWS 3 PRECEDING)';
   
   assertEquals($expected, 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg" from TDSRow as "root" WINDOW myWindow AS (PARTITION BY "root".col1 ORDER BY "root".col3 ASC ROWS 3 PRECEDING)');
}

function <<test.Test>> meta::relational::tests::selectSubClauses::window::testWindowWithoutPartition():Boolean[1]
{
   let expected = 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg" from TDSRow as "root" WINDOW myWindow AS (ORDER BY "root".col3 ASC)';
   
   assertEquals($expected, 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg" from TDSRow as "root" WINDOW myWindow AS (ORDER BY "root".col3 ASC)');
}

function <<test.Test>> meta::relational::tests::selectSubClauses::window::testWindowWithoutSort():Boolean[1]
{
   let expected = 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg" from TDSRow as "root" WINDOW myWindow AS (PARTITION BY "root".col1)';
   
   assertEquals($expected, 'select "root".id as "id", "root".val as "val", avg("root".val) OVER myWindow as "avg" from TDSRow as "root" WINDOW myWindow AS (PARTITION BY "root".col1)');
}
